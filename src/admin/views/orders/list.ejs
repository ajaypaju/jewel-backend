<%- include('../partials/header', { currentPage: 'orders', pageTitle: 'Orders' }) %>

<div class="card-header mb-4">
  <div class="card-title" style="font-size:20px;">Orders (<%= total %>)</div>
</div>

<!-- Status filter -->
<div class="card mb-4" style="padding:12px 16px;">
  <form method="GET" action="/admin/orders" class="d-flex gap-2 align-center">
    <select name="status" class="form-control" style="max-width:200px;">
      <option value="">All Statuses</option>
      <% statuses.forEach(s => { %>
        <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-outline">Filter</button>
    <% if (statusFilter) { %>
      <a href="/admin/orders" class="btn btn-outline">Clear</a>
    <% } %>
  </form>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Customer</th>
          <th>Items</th>
          <th>Total</th>
          <th>Status</th>
          <th>Payment</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
          <tr><td colspan="7" class="text-muted" style="text-align:center;padding:24px;">No orders found.</td></tr>
        <% } %>
        <% orders.forEach(order => { %>
          <tr>
            <td>
              <a href="/admin/orders/<%= order.id %>" title="<%= order.id %>">
                <%= order.id.substring(0, 8) %>…
              </a>
            </td>
            <td>
              <% if (order.user) { %>
                <div><%= order.user.name %></div>
                <div class="text-muted text-sm"><%= order.user.email %></div>
              <% } else { %>
                <span class="text-muted">Unknown</span>
              <% } %>
            </td>
            <td><%= order.items ? order.items.length : 0 %></td>
            <td class="price">$<%= Number(order.total).toFixed(2) %></td>
            <td><span class="badge badge-<%= order.status %>"><%= order.status %></span></td>
            <td><span class="badge badge-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></td>
            <td class="text-muted text-sm"><%= new Date(order.createdAt).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% const qs = new URLSearchParams({ page: String(i), status: statusFilter || '' }).toString(); %>
        <a href="/admin/orders?<%= qs %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
