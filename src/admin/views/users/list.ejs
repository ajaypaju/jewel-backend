<%- include('../partials/header', { currentPage: 'users', pageTitle: 'Customers' }) %>

<div class="card-header mb-4">
  <div class="card-title" style="font-size:20px;">Customers (<%= users.length %>)</div>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Tier</th>
          <th>Status</th>
          <th>Joined</th>
          <th style="width:80px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="7" class="text-muted" style="text-align:center;padding:24px;">No users yet.</td></tr>
        <% } %>
        <% users.forEach(u => { %>
          <tr>
            <td><strong><%= u.name %></strong></td>
            <td class="text-sm"><%= u.email %></td>
            <td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
            <td><%= u.tier %></td>
            <td>
              <% if (u.isActive) { %>
                <span class="badge badge-active">Active</span>
              <% } else { %>
                <span class="badge badge-inactive">Inactive</span>
              <% } %>
            </td>
            <td class="text-muted text-sm"><%= new Date(u.createdAt).toLocaleDateString() %></td>
            <td><a href="/admin/users/<%= u.id %>" class="btn btn-outline btn-sm">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
