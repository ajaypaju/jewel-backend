<%- include('../partials/header', { currentPage: 'categories', pageTitle: 'Categories' }) %>

<div class="card-header mb-4">
  <div class="card-title" style="font-size:20px;">Categories (<%= categories.length %>)</div>
  <a href="/admin/categories/new" class="btn btn-primary">+ Add Category</a>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Slug</th>
          <th>Sort Order</th>
          <th>Products</th>
          <th>Description</th>
          <th style="width:140px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (categories.length === 0) { %>
          <tr><td colspan="6" class="text-muted" style="text-align:center;padding:24px;">No categories yet.</td></tr>
        <% } %>
        <% categories.forEach(cat => { %>
          <tr>
            <td><strong><%= cat.name %></strong></td>
            <td class="text-muted text-sm"><%= cat.slug %></td>
            <td><%= cat.sortOrder %></td>
            <td>
              <% const count = productCounts[cat.id] || 0; %>
              <span class="badge <%= count > 0 ? 'badge-confirmed' : 'badge-pending' %>"><%= count %> product<%= count !== 1 ? 's' : '' %></span>
            </td>
            <td class="text-muted text-sm"><%= cat.description ? cat.description.substring(0, 50) + (cat.description.length > 50 ? '…' : '') : '—' %></td>
            <td>
              <div class="d-flex gap-2">
                <a href="/admin/categories/<%= cat.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                <form method="POST" action="/admin/categories/<%= cat.id %>/delete" style="margin:0;" onsubmit="return confirm('Delete this category?')">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
