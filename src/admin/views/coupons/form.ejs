<%- include('../partials/header', { currentPage: 'coupons', pageTitle: pageTitle }) %>

<div class="mb-4">
  <a href="/admin/coupons" style="color:var(--text-muted);font-size:14px;">← Back to Coupons</a>
</div>

<div class="card">
  <div class="card-title mb-4"><%= pageTitle %></div>

  <form method="POST" action="<%= coupon ? '/admin/coupons/' + coupon.id : '/admin/coupons' %>">

    <div class="form-row">
      <div class="form-group">
        <label for="code">Coupon Code *</label>
        <input type="text" id="code" name="code" class="form-control" required
               value="<%= coupon ? coupon.code : '' %>" placeholder="e.g. WELCOME10" style="text-transform:uppercase;">
      </div>
      <div class="form-group">
        <label for="type">Type *</label>
        <select id="type" name="type" class="form-control" required>
          <option value="percent" <%= coupon && coupon.type === 'percent' ? 'selected' : '' %>>Percent (%)</option>
          <option value="fixed" <%= coupon && coupon.type === 'fixed' ? 'selected' : '' %>>Fixed ($)</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="value">Value *</label>
        <input type="number" id="value" name="value" class="form-control" required min="0.01" step="0.01"
               value="<%= coupon ? Number(coupon.value) : '' %>" placeholder="e.g. 10">
      </div>
      <div class="form-group">
        <label for="minOrder">Minimum Order ($)</label>
        <input type="number" id="minOrder" name="minOrder" class="form-control" min="0" step="0.01"
               value="<%= coupon && coupon.minOrder ? Number(coupon.minOrder) : '' %>" placeholder="Optional">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="maxUses">Max Uses</label>
        <input type="number" id="maxUses" name="maxUses" class="form-control" min="1"
               value="<%= coupon && coupon.maxUses ? coupon.maxUses : '' %>" placeholder="Unlimited">
      </div>
      <div class="form-group">
        <label for="expiresAt">Expires At</label>
        <input type="date" id="expiresAt" name="expiresAt" class="form-control"
               value="<%= coupon && coupon.expiresAt ? new Date(coupon.expiresAt).toISOString().split('T')[0] : '' %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-check">
        <input type="checkbox" name="isActive" <%= !coupon || coupon.isActive ? 'checked' : '' %>>
        <span>Active</span>
      </label>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= coupon ? 'Update Coupon' : 'Create Coupon' %></button>
      <a href="/admin/coupons" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
